<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edição - HC Multimarcas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container">
    <a class="navbar-brand" href="index.html">HC <span>Multimarcas</span></a>
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="index.html">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="produtos.html">Produtos</a></li>
        <li class="nav-item"><a class="nav-link" href="sobre.html">Sobre</a></li>
        <li class="nav-item"><a class="nav-link" href="contato.html">Contato</a></li>
      </ul>
    </div>
  </div>
</nav>

<section class="section-header">
  <style>.section-header::before { content: 'EDIÇÃO'; }</style>
  <h1>Modo de Edição</h1>
  <p>Altere os itens do catálogo</p>
</section>

<main class="container py-5">
  <div class="row g-5 justify-content-center">
    
    <div class="col-lg-10">
      <div class="contato-card mb-5">
        <p style="font-size:.72rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--destaque);margin-bottom:4px;">Administração</p>
        <h2 style="font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:3px;margin-bottom:1.5rem;">Inserir Novo Item</h2>

        <form action="#" method="post" class="form-hc row g-3">
          <div class="col-md-4">
            <label>Tipo</label>
            <input type="text" class="form-control" placeholder="Ex: Produto">
          </div>
          <div class="col-md-4">
            <label>Nome</label>
            <input type="text" class="form-control" placeholder="Nome do item">
          </div>
          <div class="col-md-4">
            <label>Descrição</label>
            <input type="text" class="form-control" placeholder="Detalhes do item">
          </div>
          <div class="col-md-4">
            <label>Valor</label>
            <input type="number" class="form-control" placeholder="R$ 0,00">
          </div>
          <div class="col-md-4">
            <label>Status</label>
            <select class="form-control">
              <option selected disabled>Selecione</option>
              <option>Ativo</option>
              <option>Inativo</option>
            </select>
          </div>
          <div class="col-md-4">
            <label>Imagem</label>
            <input type="file" class="form-control">
          </div>
          <div class="col-12 text-end mt-4">
            <button type="submit" class="btn-hc-dark px-5">
              Salvar Item
            </button>
          </div>
        </form>
      </div>

      <div class="contato-card">
        <p style="font-size:.72rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--destaque);margin-bottom:4px;">Atualização</p>
        <h2 style="font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:3px;margin-bottom:1.5rem;">Editar Item</h2>

        <form class="form-hc row g-3" method="post">
          <div class="col-md-2">
            <label>Id</label>
            <input type="text" class="form-control" placeholder="Ex: 001">
          </div>
          <div class="col-md-5">
            <label>Tipo</label>
            <input type="text" class="form-control" placeholder="Ex: Produto">
          </div>
          <div class="col-md-5">
            <label>Nome</label>
            <input type="text" class="form-control" placeholder="Nome do item">
          </div>
          <div class="col-md-12">
            <label>Descrição</label>
            <input type="text" class="form-control" placeholder="Detalhes do item">
          </div>
          <div class="col-md-4">
            <label>Valor</label>
            <input type="number" class="form-control" placeholder="R$ 0,00">
          </div>
          <div class="col-md-4">
            <label>Status</label>
            <select class="form-control">
              <option selected disabled>Selecione</option>
              <option>Ativo</option>
              <option>Inativo</option>
            </select>
          </div>
          <div class="col-md-4">
            <label>Imagem</label>
            <input type="file" class="form-control">
          </div>
          <div class="col-12 text-end mt-4">
            <button type="submit" class="btn-hc-dark px-5">
              Salvar Alterações
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</main>

<footer>
  <p><strong>HC Multimarcas</strong> — Tijucas / SC</p>
  <p>© 2026 Todos os direitos reservados</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
